CREATE TABLE tatuador 
( 
 idTatuador INT AUTO_INCREMENT PRIMARY KEY,  
 idsenioridade INT AUTO_INCREMENT PRIMARY KEY,  
 telefone INT,  
 nomeTatuador INT,  
 cpf INT,  
 dataContratacao INT,  
 email INT
); 

CREATE TABLE senioridade 
( 
 codSenioridade INT AUTO_INCREMENT PRIMARY KEY,  
 nome INT
); 

CREATE TABLE agendamento 
( 
 idAgendamento INT AUTO_INCREMENT PRIMARY KEY,  
 idtatuador INT AUTO_INCREMENT PRIMARY KEY,  
 idcliente INT AUTO_INCREMENT PRIMARY KEY,  
 status INT,  
 valorTatuagem INT,  
 dataAgendamento INT,  
 horaAgendamento INT,  
 desenhoAprovado INT,  
 descricaoTatuagem INT
); 

CREATE TABLE cliente 
( 
 idCliente INT AUTO_INCREMENT PRIMARY KEY,  
 telefone INT,  
 nome INT,  
 cpf INT,  
 dataCadastro INT,  
 cidade INT,  
 uf INT
); 

CREATE TABLE estilo 
( 
 idEstilo INT AUTO_INCREMENT PRIMARY KEY,  
 Estilo INT
); 

CREATE TABLE possui 
( 
 idTatuador INT AUTO_INCREMENT PRIMARY KEY,  
 idEstilo INT AUTO_INCREMENT PRIMARY KEY,  
 dataEstilo INT
); 

